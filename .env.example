# Server (copy to server/.env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: leave empty to run without DB persistence (in-memory only)
# Client (copy to client/.env) — optional in dev: defaults to same host as the page + :3001
# (so phones on Wi‑Fi work). Only set this if the API is on a different host.
# VITE_SOCKET_URL=http://localhost:3001
